# Public values compiled into the browser bundle. Never put secrets here.
VITE_APP_ENV=development
VITE_BUILD_COMMIT=local
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional observability. Public, browser-safe values, set in preview and
# production only. Leave blank to disable. See docs/operations for setup.
VITE_SENTRY_DSN=
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://eu.i.posthog.com

# Server/build-only comma-separated project references. Do not prefix with VITE_.
COOKSMITH_PRODUCTION_SUPABASE_PROJECT_REFS=
