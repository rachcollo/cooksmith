# Public values compiled into the browser bundle. Never put secrets here.
VITE_APP_ENV=development
VITE_BUILD_COMMIT=local
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional observability. These are public client values, not secrets. Leave
# blank to disable error monitoring and product analytics entirely.
VITE_SENTRY_DSN=
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=

# Server/build-only comma-separated project references. Do not prefix with VITE_.
COOKSMITH_PRODUCTION_SUPABASE_PROJECT_REFS=
